# Plain web server image (temporary hosting, e.g. Render). The AWS deployment uses deploy/deploy.sh.
FROM python:3.13-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY server server
COPY web web
COPY models models
ENV SPOTTER_POLLY=0 PORT=8080
CMD ["sh", "-c", "uvicorn server.app:app --host 0.0.0.0 --port ${PORT}"]
